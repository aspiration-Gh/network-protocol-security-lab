{
 "id": "ssh",
 "notes": {
  "Cookie": {
   "short": "16 字节随机数，混进密钥推导",
   "more": "双方各生成一个并互相交换，作为共享秘密 K 与交换哈希 H 的输入之一，使任何一方都无法单独决定会话密钥与 session_id。",
   "sec": "随机源若可预测，会话密钥就能被预先算出，历史上有过真实的密钥泄露案例。"
  },
  "kex_algorithms": {
   "short": "算法清单，取交集最弱者胜出",
   "more": "4 字节长度加逗号分隔的算法名，按偏好从高到低排列；协商取客户端列表里第一个服务器也支持的项，因此清单里留着弱算法就会被选中。",
   "sec": "清单里还有 1024 位群，被动录包者就能靠预计算解密整段会话。"
  },
  "Message Code": {
   "short": "消息号决定分派到哪一层",
   "more": "传输层 1-49、认证层 50-79、连接层 80 以上；20 是 KEXINIT，50 是认证请求，51 与 52 是失败与成功。",
   "sec": "协商阶段只许发 1-49 号消息，这条约束挡住明文阶段提前跳进认证流程。"
  },
  "Method Name": {
   "short": "none 探测会回显可用方法",
   "more": "none 是不带任何凭据的探测，服务器必定回 51，并在列表里给出真正支持的方法：publickey、password、keyboard-interactive。",
   "sec": "回显的方法列表直接告诉攻击者该爆破口令还是该去找私钥。"
  }
 },
