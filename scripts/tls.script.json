{
 "id": "tls",
 "notes": {
  "Client Version": {
   "short": "降级攻击的主战场，就两个字节",
   "more": "客户端在 ClientHello 里报自己支持的最高版本（本例 0x0303 即 TLS 1.2）；服务器若只支持更低版本就回自己的版本，客户端再自行判断是否接受。",
   "sec": "中间人把它改成 0x0300 或 0x0301，双方就会在 SSLv3/TLS1.0 上握手；TLS_FALLBACK_SCSV 与 1.3 的降级哨兵都是针对这一点打的补丁。"
  },
  "Cipher Suites": {
   "short": "列表里留着弱套件＝自备降级路",
   "more": "每个套件 2 字节，按客户端偏好降序排列。本例四个里 0xc02f 是 ECDHE+AES-GCM，0x009c 是静态 RSA，0x002f 是 CBC。",
   "sec": "只要列表里还有静态 RSA 或 CBC，中间人让前两个「协商失败」就能把连接拖到弱套件上；弱套件留在列表里等于自己提供了降级路径。"
  },
  "Session ID": {
   "short": "恢复会话的 bearer 凭证",
   "more": "32 字节会话标识，服务器在 ServerHello 里回填表示接受恢复，此后双方跳过证书鉴别，直接用缓存的主密钥与套件。它必须随机、不可枚举，并设置合理的过期时间。",
   "sec": "拿到会话 ID 就能恢复别人的会话；可预测或长期有效的会话表等于一条后门。同理，恢复路径绕过证书鉴别是 triple handshake 的入口。"
  },
  "extended_master_secret (0x0017)": {
   "short": "空扩展，专治握手被移植",
   "more": "启用后主密钥派生会把整段握手 transcript 的哈希也纳入输入，而不再只用两个随机数。服务器在 ServerHello 里回显该扩展即表示同意。",
   "sec": "没有它，攻击者可以把一条握手的密钥「移植」到另一条会话（triple handshake）；服务器不回显就等于这条防护被静默关掉。"
  }
 },
