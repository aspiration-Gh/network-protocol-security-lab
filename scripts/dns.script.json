{
 "id": "dns",
 "notes": {
  "ID": {
   "short": "16 位事务标识，可枚举",
   "more": "查询方随机生成，应答必须原样复制。接收方只靠它把响应与待决查询配对，取值空间 65536，平均发三万多条候选就能命中。",
   "sec": "它是整个协议唯一的血缘证明，也是 Kaminsky 攻击的全部成本。"
  },
  "QNAME": {
   "short": "长度前缀域名，隧道塞数据",
   "more": "域名不是点分字符串，而是“长度字节+标签”串，末字节 0x00 为根。单标签≤63 字节、全名≤255 字节，长度上限同时限定了隧道单包容量。",
   "sec": "标签逼近 63 且熵值高，是隧道最硬的外形特征。"
  },
  "ANCOUNT": {
   "short": "回答数，伪造时故意留空",
   "more": "声明答案区记录条数。查询报文为 0，响应里是直接回答的条数。伪造者不知道真实 A 记录，只能把它写成 0，转而把内容塞进授权区。",
   "sec": "“答不上来却给了指引”正是投毒报文的指纹。"
  },
  "NSCOUNT": {
   "short": "授权数，投毒的注入点",
   "more": "声明授权区条目数，原本用于告诉解析器下一步该问哪些权威服务器。它天然携带“与问题无关的指引”，因此是名字连锁攻击的落脚处。",
   "sec": "问 A 却收到 B 域的 NS，说明解析权正在被移交。"
  },
  "TTL": {
   "short": "缓存时长＝劫持时长",
   "more": "记录可被缓存的秒数。易变的 A 记录通常 300~600 秒，稳定的 NS 记录约 172800 秒。写得越长，攻击者一次命中的收益越久。",
   "sec": "陌生记录配上千古长 TTL，是伪造报文的强特征。"
  },
  "RDATA": {
   "short": "记录数据，最终连向的地址",
   "more": "按 TYPE 解释的载荷：A 记录是 4 字节 IPv4，TXT 是文本，NS 是主机名。用户最终连到哪个 IP，就由这串字节决定。",
   "sec": "整个 DNS 安全体系要守的就是这 4 个字节。"
  },
  "ARCOUNT": {
   "short": "附加数，放大与隧道特征",
   "more": "声明附加区条目数，通常是 NS 对应的 A 记录，启用 EDNS 后至少为 1（OPT 伪记录）。异常偏大意味着响应体积异常。",
   "sec": "小查询换来数 KB 应答，是反射放大与隧道的共同形状。"
  },
  "TYPE": {
   "short": "资源类型，决定载荷怎么读",
   "more": "2 字节类型值：A=1、NS=2、CNAME=5、MX=15、TXT=16、AAAA=28、OPT=41。同一段字节，类型不同解释完全不同。",
   "sec": "TXT/NULL 记录频次异常是隐蔽信道的典型信号。"
  }
 },
