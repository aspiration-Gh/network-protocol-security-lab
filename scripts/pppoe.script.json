{
 "id": "pppoe",
 "notes": {
  "Session ID": {
   "short": "16 位会话号，明文可见",
   "more": "发现阶段固定 0x0000，PADS 里由服务器分配，之后整个会话不变。会话由「源 MAC + 目的 MAC + Session ID」三要素唯一确定，三者全明文。",
   "sec": "抓到一次就能复制三要素，注入与伪造 PADT 都不需要凭证。"
  },
  "TAG AC-Cookie": {
   "short": "服务器发的不透明令牌",
   "more": "PADO 里下发，客户端必须在 PADR 中原样带回。它让服务器先确认「这个客户端能单播收到我的应答」，提高伪造源 MAC 的抢答成本。",
   "sec": "只提高成本不消除攻击：真 Cookie 可以被转发，抢答者仍能骗过客户端。"
  },
  "TAG Host-Uniq": {
   "short": "客户端配对用的随机值",
   "more": "客户端自选，服务器必须在 PADO 里原样回填。它解决的是「哪个应答对应我这次的 PADI」，不承担任何身份鉴别作用。",
   "sec": "配对成功不等于对端可信，客户端没有验证 PADO 来源的手段。"
  },
  "PPP Protocol": {
   "short": "PPP 内层协议，决定载荷",
   "more": "0x0021 是 IPv4，0xC021 LCP、0xC023 PAP、0xC223 CHAP、0x8021 IPCP。会话阶段 0x8864 之后就是它，决定后面载荷的类型。",
   "sec": "认证与数据同走这一层且都明文，抓到会话就等于拿到 PPP 全部内容。"
  }
 },
