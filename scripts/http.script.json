{
 "id": "http",
 "notes": {
  "Method": {
   "short": "方法即能力，PUT 最险",
   "more": "3 字节大写 ASCII，定义对资源的动作：GET/HEAD 读、POST 提交、PUT 覆盖、DELETE 删除、OPTIONS 探测、TRACE 回显。方法本身不带权限语义。",
   "sec": "服务端误开 PUT，等于把写权限交给全网；TRACE 未关可被用于跨站追踪。"
  },
  "Request-Target": {
   "short": "路径加查询串，GET 必外泄",
   "more": "origin-form 的目标，包含路径与查询串。查询串会进浏览器历史、代理日志与 Referer 头，任何中间环节都能读到。",
   "sec": "凭据绝不能放查询串，它天然被记录、被转发给第三方。"
  },
  "Host-Value": {
   "short": "虚拟主机路由的枢纽",
   "more": "HTTP/1.1 唯一必选首部的值，一台服务器用同一个 IP 承载多个站点，全靠这个名字决定命中哪个 vhost。",
   "sec": "改成 internal.admin.example 常能直接摸到只绑内网域名的后台。"
  },
  "Cookie-Value": {
   "short": "会话凭据，拿到即等于本人",
   "more": "键值对形式，SID 是服务端会话的索引，服务端不认人只认这串字符。整个会话体系里价值最高的一小段字节。",
   "sec": "嗅探可截、XSS 可读、CSRF 可借，三者都不需要破解任何加密。"
  },
  "Set-Cookie:": {
   "short": "服务端下发凭据的唯一途径",
   "more": "响应首部，携带键值对与属性：Path 限定发送路径，HttpOnly 禁止脚本读取，Secure 限定只在 TLS 下发送，SameSite 控制跨站携带。",
   "sec": "缺 HttpOnly 是 XSS 偷凭据的前提，缺 SameSite 是 CSRF 的前提。"
  },
  "Cookie-Attrs": {
   "short": "属性决定凭据能被谁拿走",
   "more": "Cookie 值与属性的合体。属性是边界不是建议：HttpOnly 让 document.cookie 读不到，Secure 让明文请求不带它，SameSite 拦跨站自动携带。",
   "sec": "三个属性各封一条窃取路径，缺一条就漏一条。"
  },
  "Content-Length:": {
   "short": "长度声明，偷渡的入口",
   "more": "声明主体字节数的两种方式之一，另一种是 Transfer-Encoding: chunked。两者同时出现且矛盾时，前后端可能各信一个。",
   "sec": "CL.TE 与 TE.CL 的成立条件，就是这条首部与 TE 的解释不一致。"
  },
  "CL-Value": {
   "short": "长度值，与实际字节比对",
   "more": "主体字节数。它必须与真实正文逐字节吻合；偏大就会把后续报文的字节吞进本次主体，偏小则把剩余字节留给下一个请求。",
   "sec": "长度与实际不符是响应拆分与走私的共同产物。"
  },
  "R+StreamID": {
   "short": "流标识，HTTP/2 的并发单位",
   "more": "31 位流标识加 1 位保留位。帧属于流、流属于连接，多条流可在一条 TCP 上并发并乱序重组；SETTINGS 作用于整条连接故为 0。",
   "sec": "跳号或复用已关闭的流是协议错误，也是某些实现崩溃的触发点。"
  },
  "Flags": {
   "short": "帧标志，语义随类型变",
   "more": "8 位标志，含义由帧类型决定：DATA 的 0x01 是 END_STREAM、0x08 是 PADDED；SETTINGS 的 0x01 是 ACK。同一字节解释不同。",
   "sec": "对标志位理解不一致，就是新一代走私的夹带区。"
  }
 },
