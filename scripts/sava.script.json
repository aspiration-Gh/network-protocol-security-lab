{
 "id": "sava",
 "notes": {
  "Source Address": {
   "short": "自填的回信地址，没有任何签名",
   "more": "发送方构造首部时自己写，协议没有规定它必须与实际接入位置一致，也没有任何字段能证明它属于谁；上层却拿它当身份用。",
   "sec": "整份体系的安全缺口就在这 4 个字节：身份与位置被压进了同一个字段。"
  },
  "Header Checksum": {
   "short": "只是反码求和，人人可重算",
   "more": "只对首部 20 字节做反码求和，保证比特传输没出错；改完源地址顺手重算一次，报文就完全合法。",
   "sec": "最容易被误读的字段：它防误码，不防伪造。"
  },
  "Type": {
   "short": "回显请求 8，应答确定且立刻返回",
   "more": "ICMP 类型 8 是回显请求、0 是回显应答；请求小、应答确定且立即返回，因此最适合被借来当反射器。",
   "sec": "28 字节的请求换回 28 字节以上的应答，放大倍数再乘以反射器数量。"
  }
 },
