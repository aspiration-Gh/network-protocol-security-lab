        "s": "《系统》PowerShell.md · 网络管理 Cmdlet"
       },
       {
        "c": "Get-NetTCPConnection -RemotePort 443 | Select LocalPort,RemoteAddress,State",
        "n": "列本机连到 443 的所有连接与状态",
        "s": "《系统》PowerShell.md · Get-NetTCPConnection"
       }
      ],
      "cmd": [
       {
        "c": "netstat -ano | findstr :443",
        "n": "连接 + 所属 PID，最老的排障起手式",
