{
 "id": "arp",
 "notes": {
  "EtherType": {
   "short": "帧类型 0x0806 表示 ARP",
   "more": "以太网帧头 14 字节里的最后 2 字节，0x0806 是 ARP，0x0800 是 IPv4，0x86DD 是 IPv6。交换机靠它决定把载荷交给哪个上层解析。",
   "sec": "伪造时 EtherType 必须写对，否则接收端根本不进 ARP 处理。"
  },
  "Hardware Type": {
   "short": "硬件类型，以太网为 1",
   "more": "16 位，0x0001 表示以太网。它和下面的协议类型、两个长度字段一起，说明「用什么地址去解析什么地址」。",
   "sec": "长度字段被改成非 6/4 时，解析器若不复核就会越界读。"
  },
  "Operation": {
   "short": "1 请求 / 2 应答，无认证位",
   "more": "16 位操作码，只有请求、应答与 RARP 四种取值。没有序号、没有签名，接收端无法把一条应答和任何请求对应起来。",
   "sec": "把操作码写成 2，一条「合法应答」就构造完成了。"
  },
  "Sender Hardware Address": {
   "short": "发送方 MAC，可随意填写",
   "more": "48 位，本应等于帧头源 MAC。交换机只看帧头学转发表，主机只看这里更新缓存——两个平面被分开处理，就产生了伪造空间。",
   "sec": "帧头写真实网卡保证回程可达，载荷写别人的 MAC 完成冒充。"
  },
  "Sender Protocol Address": {
   "short": "发送方 IP，冒充的落点",
   "more": "32 位。填谁的地址，接收端就把谁的 IP 映射到发送方 MAC 上。填网关地址就是冒充网关，填内网主机地址就是骗网关。",
   "sec": "同一 IP 出现多个 MAC，是 ARP 欺骗最直接的判据。"
  },
  "Target Hardware Address": {
   "short": "目标 MAC，请求时全 0",
   "more": "48 位。请求报文里因为还不知道对方硬件地址，填全 0；应答里填请求方的 MAC。有些实现会直接拿它覆盖缓存。",
   "sec": "把应答发给广播地址，一次就能覆盖整个广播域。"
  },
  "Target Protocol Address": {
   "short": "被解析的 IP",
   "more": "32 位，请求时是「我在找谁」的地址，应答时是发起解析的那一方的地址。扫描就是拿它做递增遍历。",
   "sec": "逐个递增地发请求，几秒就能测绘整个广播域。"
  }
 },
